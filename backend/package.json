{
  "name": "solarium-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate",
    "dev": "node --watch src/server.js",
    "start": "node --max-old-space-size=384 src/server.js",
    "prestart": "prisma generate",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@supabase/supabase-js": "2.57.4",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsqr": "^1.4.0",
    "multer": "2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "7.9.1"
  }
}
