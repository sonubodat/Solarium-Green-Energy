generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  ADMIN
  SALES
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum QrStatus {
  UNASSIGNED
  ACTIVE
  INACTIVE
  RETIRED
}

enum PayoutStatus {
  UNPAID
  PAID
  PARTIAL
}

enum VendorRegistrationStatus {
  PENDING
  ONBOARDED
  REJECTED
}

enum QrPrintTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Distinguishes a multi-code print batch from a single-code designed PDF download. A batch
// can legitimately contain one code, so the two cannot be told apart by itemCount alone.
enum QrPrintKind {
  BATCH
  SINGLE
}

enum QrPrintJobStatus {
  QUEUED
  PROCESSING
  PROOF_READY
  APPROVED
  GENERATING
  PENDING_APPROVAL
  REJECTED
  COMPLETED
  FAILED
}

enum QrPrintItemStatus {
  PENDING
  PROOF_READY
  GENERATED
  FAILED
}

model User {
  id             String               @id @default(cuid())
  name           String
  usernameMobile String               @unique @map("username_or_mobile")
  passwordHash   String               @map("password_hash")
  role           StaffRole
  status         AccountStatus        @default(ACTIVE)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  ownedVendors   Vendor[]             @relation("SalesOwner")
  assignments    QrAssignment[]
  payoutsPaid    Payout[]             @relation("PayoutPaidBy")
  auditLogs      AuditLog[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  registrations  VendorRegistration[]
  printTemplates QrPrintTemplate[]
  printJobs      QrPrintJob[]

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model Vendor {
  id                 String                 @id @default(cuid())
  businessName       String                 @map("business_name")
  ownerName          String                 @map("owner_name")
  loginIdentifier    String                 @unique @map("login_identifier")
  mobileNumber       String                 @map("mobile_number")
  passwordHash       String?                @map("password_hash")
  mustChangePassword Boolean                @default(true) @map("must_change_password")
  status             AccountStatus          @default(ACTIVE)
  salesUserId        String?                @map("sales_user_id")
  state              String?
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  salesUser          User?                  @relation("SalesOwner", fields: [salesUserId], references: [id])
  assignments        QrAssignment[]
  scans              Scan[]
  leads              Lead[]
  payouts            Payout[]
  bankDetails        VendorBankDetails?
  onboardingMedia    VendorOnboardingMedia?
  sessions           Session[]
  resetTokens        PasswordResetToken[]
  registrations      VendorRegistration[]

  @@index([mobileNumber])
  @@index([status, createdAt])
  @@index([salesUserId])
  @@map("vendors")
}

model VendorRegistration {
  id              String                   @id @default(cuid())
  vendorId        String?                  @unique @map("vendor_id")
  businessName    String                   @map("business_name")
  ownerName       String                   @map("owner_name")
  mobileNumber    String                   @map("mobile_number")
  loginIdentifier String                   @unique @map("login_identifier")
  salesUserId     String?                  @map("sales_user_id")
  status          VendorRegistrationStatus @default(PENDING)
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  vendor          Vendor?                  @relation(fields: [vendorId], references: [id])
  salesUser       User?                    @relation(fields: [salesUserId], references: [id])

  @@index([salesUserId, status, createdAt])
  @@map("vendor_registrations")
}

model QrCode {
  id            String           @id @default(cuid())
  code          String           @unique
  status        QrStatus         @default(UNASSIGNED)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  assignments   QrAssignment[]
  scans         Scan[]
  leads         Lead[]
  printJobItems QrPrintJobItem[]

  @@index([status])
  @@map("qr_codes")
}

model QrAssignment {
  id           String    @id @default(cuid())
  qrCodeId     String    @map("qr_code_id")
  vendorId     String    @map("vendor_id")
  assignedById String?   @map("assigned_by")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  qrCode       QrCode    @relation(fields: [qrCodeId], references: [id])
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  assignedBy   User?     @relation(fields: [assignedById], references: [id])
  scans        Scan[]
  leads        Lead[]

  @@index([qrCodeId, unassignedAt])
  @@index([vendorId, assignedAt])
  @@map("qr_assignments")
}

model CustomerIdentity {
  id        String   @id @default(cuid())
  hash      String   @unique @map("customer_hash")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  scans     Scan[]
  leads     Lead[]

  @@map("customer_identities")
}

model Scan {
  id                 String            @id @default(cuid())
  qrId               String            @map("qr_id")
  qrAssignmentId     String            @map("qr_assignment_id")
  vendorId           String            @map("vendor_id")
  customerIdentityId String?           @map("customer_identity_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  qr                 QrCode            @relation(fields: [qrId], references: [id])
  assignment         QrAssignment      @relation(fields: [qrAssignmentId], references: [id])
  vendor             Vendor            @relation(fields: [vendorId], references: [id])
  customerIdentity   CustomerIdentity? @relation(fields: [customerIdentityId], references: [id])
  lead               Lead?

  @@index([qrId, createdAt])
  @@index([vendorId, createdAt])
  @@index([qrAssignmentId])
  @@map("scans")
}

model Lead {
  id                     String           @id @default(cuid())
  vendorId               String?          @map("vendor_id")
  vendorNameSnapshot     String           @map("vendor_name_snapshot")
  qrId                   String           @map("qr_id")
  qrAssignmentId         String?          @map("qr_assignment_id")
  scanId                 String?          @unique @map("scan_id")
  // Enforces global one-lead-per-customer at the database level (chosen business rule: a
  // customer already attributed to one vendor cannot generate a second lead under another
  // vendor's QR). Application-level checks alone cannot prevent this under concurrent requests.
  customerIdentityId     String           @unique @map("customer_identity_id")
  customerName           String           @map("customer_name")
  phone                  String
  email                  String?
  location               String?
  pincode                String?
  averageElectricityBill String?          @map("average_electricity_bill")
  solarSize              String?          @map("solar_size")
  status                 String
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  vendor                 Vendor?          @relation(fields: [vendorId], references: [id])
  qr                     QrCode           @relation(fields: [qrId], references: [id])
  assignment             QrAssignment?    @relation(fields: [qrAssignmentId], references: [id])
  scan                   Scan?            @relation(fields: [scanId], references: [id])
  customerIdentity       CustomerIdentity @relation(fields: [customerIdentityId], references: [id])
  payout                 Payout?
  geoLocation            LeadLocation?

  @@index([vendorId, createdAt])
  @@index([qrId, createdAt])
  @@index([qrAssignmentId])
  @@index([status])
  @@map("leads")
}

// Pilot scope, deliberately minimal: optional GPS captured client-side via the public
// enquiry form's "Use my location" button, submitted only alongside a lead the customer
// is actually creating (never a standalone endpoint a client could point at someone else's
// lead_id). No location history, no vendor/login location, no IP geolocation — see
// docs/data-model.md for why this stays deliberately narrow for now.
model LeadLocation {
  id         String   @id @default(cuid())
  leadId     String   @unique @map("lead_id")
  latitude   Float
  longitude  Float
  accuracy   Float?
  capturedAt DateTime @map("captured_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lead       Lead     @relation(fields: [leadId], references: [id])

  @@map("lead_locations")
}

model Payout {
  id            String       @id @default(cuid())
  leadId        String       @unique @map("lead_id")
  vendorId      String       @map("vendor_id")
  status        PayoutStatus @default(UNPAID)
  paidAt        DateTime?    @map("paid_at")
  paidById      String?      @map("paid_by")
  paidReference String?      @map("paid_reference")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  lead          Lead         @relation(fields: [leadId], references: [id])
  vendor        Vendor       @relation(fields: [vendorId], references: [id])
  paidBy        User?        @relation("PayoutPaidBy", fields: [paidById], references: [id])

  @@index([vendorId, status])
  @@index([paidAt])
  @@map("payouts")
}

model VendorBankDetails {
  id                  String   @id @default(cuid())
  vendorId            String   @unique @map("vendor_id")
  upiNumber           String?  @map("upi_number")
  upiId               String?  @map("upi_id")
  accountHolderName   String?  @map("account_holder_name")
  accountNumber       String?  @map("account_number")
  ifscCode            String?  @map("ifsc_code")
  passbookObjectKey   String?  @map("passbook_object_key")
  passbookFileName    String?  @map("passbook_file_name")
  passbookFileSize    Int?     @map("passbook_file_size")
  passbookContentType String?  @map("passbook_content_type")
  chequeObjectKey     String?  @map("cheque_object_key")
  chequeFileName      String?  @map("cheque_file_name")
  chequeFileSize      Int?     @map("cheque_file_size")
  chequeContentType   String?  @map("cheque_content_type")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  vendor              Vendor   @relation(fields: [vendorId], references: [id])

  @@map("vendor_bank_details")
}

// Captured at Sales/Admin onboarding time: GPS coordinates of the Solar Mitra's shop, plus a
// photo of the shop and a photo of the Solar Mitra (the person/owner) — evidence that
// onboarding happened at the real shop. Optional and completable in pieces (all fields
// nullable): a vendor can be created before any of this exists, and each piece can be
// captured/replaced independently later. Photos are stored compressed (~800KB-1MB) in
// Supabase Storage; only the object key + metadata live here (never the file itself).
model VendorOnboardingMedia {
  id                          String    @id @default(cuid())
  vendorId                    String    @unique @map("vendor_id")
  latitude                    Float?
  longitude                   Float?
  accuracy                    Float?
  capturedAt                  DateTime? @map("captured_at")
  shopPhotoObjectKey          String?   @map("shop_photo_object_key")
  shopPhotoFileName           String?   @map("shop_photo_file_name")
  shopPhotoFileSize           Int?      @map("shop_photo_file_size")
  shopPhotoContentType        String?   @map("shop_photo_content_type")
  qrPlacementPhotoObjectKey   String?   @map("qr_placement_photo_object_key")
  qrPlacementPhotoFileName    String?   @map("qr_placement_photo_file_name")
  qrPlacementPhotoFileSize    Int?      @map("qr_placement_photo_file_size")
  qrPlacementPhotoContentType String?   @map("qr_placement_photo_content_type")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  vendor                      Vendor    @relation(fields: [vendorId], references: [id])

  @@map("vendor_onboarding_media")
}

model Session {
  id        String    @id @default(cuid())
  userId    String?   @map("user_id")
  vendorId  String?   @map("vendor_id")
  tokenHash String    @unique @map("session_token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  user      User?     @relation(fields: [userId], references: [id])
  vendor    Vendor?   @relation(fields: [vendorId], references: [id])

  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String?   @map("user_id")
  vendorId  String?   @map("vendor_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User?     @relation(fields: [userId], references: [id])
  vendor    Vendor?   @relation(fields: [vendorId], references: [id])

  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model QrPrintTemplate {
  id              String                @id @default(cuid())
  createdById     String                @map("created_by_id")
  name            String
  artworkFileName String?               @map("artwork_file_name")
  artworkPath     String?               @map("artwork_path")
  artworkMimeType String?               @map("artwork_mime_type")
  pageWidthMm     Float                 @map("page_width_mm")
  pageHeightMm    Float                 @map("page_height_mm")
  dpi             Int                   @default(300)
  qrX             Float                 @map("qr_x")
  qrY             Float                 @map("qr_y")
  qrWidth         Float                 @map("qr_width")
  qrHeight        Float                 @map("qr_height")
  labelEnabled    Boolean               @default(false) @map("label_enabled")
  labelTextX      Float?                @map("label_text_x")
  labelTextY      Float?                @map("label_text_y")
  labelFontSize   Float?                @map("label_font_size")
  version         Int                   @default(1)
  status          QrPrintTemplateStatus @default(DRAFT)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  createdBy       User                  @relation(fields: [createdById], references: [id])
  printJobs       QrPrintJob[]

  @@index([status, createdAt])
  @@index([createdById])
  @@map("qr_print_templates")
}

model QrPrintJob {
  id               String           @id @default(cuid())
  templateId       String           @map("template_id")
  createdById      String           @map("created_by_id")
  idempotencyKey   String           @unique @map("idempotency_key")
  kind             QrPrintKind      @default(BATCH)
  status           QrPrintJobStatus @default(QUEUED)
  rangeStart       String?          @map("range_start")
  rangeEnd         String?          @map("range_end")
  itemCount        Int              @default(0) @map("item_count")
  proofSummary     Json?            @map("proof_summary")
  templateSnapshot Json?            @map("template_snapshot")
  proofPath        String?          @map("proof_path")
  proofFileName    String?          @map("proof_file_name")
  proofCheckedAt   DateTime?        @map("proof_checked_at")
  proofError       String?          @map("proof_error")
  pdfPath          String?          @map("pdf_path")
  pdfFileName      String?          @map("pdf_file_name")
  generatedAt      DateTime?        @map("generated_at")
  approvedAt       DateTime?        @map("approved_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  template         QrPrintTemplate  @relation(fields: [templateId], references: [id])
  createdBy        User             @relation(fields: [createdById], references: [id])
  items            QrPrintJobItem[]

  @@index([status, createdAt])
  @@index([templateId, createdAt])
  @@map("qr_print_jobs")
}

model QrPrintJobItem {
  id           String            @id @default(cuid())
  printJobId   String            @map("print_job_id")
  qrCodeId     String            @map("qr_code_id")
  sequence     Int
  expectedCode String            @map("expected_code")
  expectedUrl  String            @map("expected_url")
  previewPath  String?           @map("preview_path")
  status       QrPrintItemStatus @default(PENDING)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  printJob     QrPrintJob        @relation(fields: [printJobId], references: [id])
  qrCode       QrCode            @relation(fields: [qrCodeId], references: [id])

  @@unique([printJobId, sequence])
  @@index([printJobId, status])
  @@index([qrCodeId])
  @@map("qr_print_job_items")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String   @map("actor_user_id")
  actorRole   String   @map("actor_role")
  action      String
  entity      String
  entityId    String   @map("entity_id")
  metadata    Json?
  timestamp   DateTime @default(now())
  actor       User     @relation(fields: [actorUserId], references: [id])

  @@index([entity, entityId])
  @@index([actorUserId, timestamp])
  @@index([timestamp])
  @@index([action, timestamp])
  @@map("audit_logs")
}

// Single-row tracker for the audit-log retention warning's "don't ask twice" behavior
// (see backend/src/lib/audit-retention.js) — persisted server-side so the acknowledgment
// survives across logins/devices, not just the current browser session.
model AuditLogRetentionState {
  id                    Int      @id @default(1)
  cleanupCycle          Int      @default(0)
  // Starts at -1 (not 0) so the very first time the table ever enters the warning zone,
  // before any cleanup has run (cleanupCycle is still 0), lastAcknowledgedCycle(-1) < 0
  // is still true and the admin gets prompted — starting both at 0 would silently skip it.
  lastAcknowledgedCycle Int      @default(-1)
  updatedAt             DateTime @updatedAt

  @@map("audit_log_retention_state")
}
