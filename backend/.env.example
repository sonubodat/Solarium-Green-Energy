# Database
# Fallback runtime connection. Prefer DIRECT_URL below — the app uses Prisma's
# interactive $transaction() throughout its mutations, which is unreliable
# against Supabase's transaction-mode pooler (port 6543) under concurrent load.
DATABASE_URL=
# Runtime AND migration connection. Use the Supabase direct/session-mode
# connection string (port 5432), not the transaction-mode pooler.
DIRECT_URL=

# Application
APP_BASE_URL=https://your-backend.onrender.com
FRONTEND_ORIGIN=https://your-frontend.vercel.app
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
# Render provides PORT automatically. Keep this only for local development.
PORT=4000
NODE_ENV=production

# Authentication and protected customer identity
SESSION_COOKIE_NAME=solarium_session
SESSION_COOKIE_SAME_SITE=None
# Days a login (Admin, Sales, Solar Mitra) stays valid. Defaults to 7, allowed 1-30. Fixed from sign-in.
SESSION_LIFETIME_DAYS=7
SESSION_SECRET=
CUSTOMER_HASH_SECRET=
# Server-only Supabase Storage configuration for private vendor documents.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=vendor-documents
# Private bucket for QR template artwork uploads (Admin QR print templates).
SUPABASE_QR_STORAGE_BUCKET=qr-artifacts
# Private bucket for Solar Mitra onboarding photos (shop + person), compressed
# to ~100KB each before storage to stay well within Supabase's free tier.
SUPABASE_VENDOR_PHOTOS_BUCKET=vendor-photos
# Minutes a password reset token stays valid before it expires. Defaults to 15.
PASSWORD_RESET_TTL_MINUTES=15
